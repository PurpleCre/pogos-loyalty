# Development only. Keep staging/production values in their own approved EAS
# environments. The public URL must match config/environments.json.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_PROJECT_REF=YOUR_APPROVED_DEVELOPMENT_PROJECT_REF
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_APPROVED_DEVELOPMENT_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Development fallback for the current connected account. Prefer separate,
# platform-restricted keys when preparing native builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_DEVELOPMENT_MAPS_KEY
ANDROID_MAPS_API_KEY=
IOS_MAPS_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Server-only GAAP credentials never belong in EXPO_PUBLIC_ values.
# GAAP_WEBHOOK_ENABLED=false
# GAAP_WEBHOOK_SECRET=configure-only-after-vendor-contract-verification
