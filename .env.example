# Client-visible configuration. Use isolated development/staging projects.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_PLATFORM_RESTRICTED_MAPS_KEY
# Optional until an environment-specific Sentry project is configured.
EXPO_PUBLIC_SENTRY_DSN=

# Server-only GAAP secrets are set through Supabase secrets, never EXPO_PUBLIC_.
# GAAP_WEBHOOK_ENABLED=false
# GAAP_WEBHOOK_SECRET=configure-only-after-vendor-signing-contract-is-confirmed
