# Development only. Keep staging/production values in their own approved EAS
# environments. The public URL must match config/environments.json.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_PROJECT_REF=YOUR_APPROVED_DEVELOPMENT_PROJECT_REF
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_APPROVED_DEVELOPMENT_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Development fallback for the current connected account. Prefer separate,
# platform-restricted keys when preparing native builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_DEVELOPMENT_MAPS_KEY
ANDROID_MAPS_API_KEY=
IOS_MAPS_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Legacy GAAP, marketing and AI endpoints are held closed. Old enable flags do
# not activate them; new reviewed implementations are required. Keep every
# integration/provider credential server-only, outside EXPO_PUBLIC_ values.
# Server-only transactional push worker. Never publish these as EXPO_PUBLIC_.
# TRANSACTIONAL_PUSH_ENABLED=false
# Generate a unique random worker secret of at least 32 characters.
# PUSH_WORKER_SECRET=
# EXPO_PUSH_ACCESS_TOKEN=configure-in-the-owned-server-environment
# Server-only expiry jobs. Each needs its own random 32–256 character secret.
# CASH_ORDER_EXPIRY_ENABLED=false
# CASH_ORDER_EXPIRY_WORKER_SECRET=
# REWARD_RESERVATION_EXPIRY_ENABLED=false
# REWARD_EXPIRY_WORKER_SECRET=
