    "client:status": "node scripts/client-data.mjs status",
    "client:check": "node scripts/client-data.mjs check",
    "client:plan": "node scripts/client-data.mjs plan",
    "client:digest": "node scripts/client-data.mjs digest",
    "client:template:check": "node scripts/client-data.mjs template-check"
  },
