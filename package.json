    "monitoring:demo": "node scripts/monitoring-demo.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "build:check": "node scripts/build-check.mjs",
    "config:check": "node scripts/config-check.mjs",
    "sdk:check": "node scripts/sdk-check.mjs",
    "doctor": "node scripts/doctor-check.mjs",
    "native:preflight": "node scripts/native-preflight.mjs",
    "deps:check": "node scripts/dependency-check.mjs",
    "privacy:pages": "node scripts/build-privacy-pages.mjs",
